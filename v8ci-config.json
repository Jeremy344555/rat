{
    "syntaxCheck" : {
      "enable" : true,
      "sources" : {
        "paths" : {
          "EXTENSION" : [ "exts"]
        }
      },
      "validateVariants" : [ "SERVER", "THICK_ORD_CLIENT", "THICK_MNG_CLIENT", "THIN_CLIENT", "WEB_CLIENT"],
      "filter" : {
        "acceptMR" : true,
        "acceptDraftMR" : true,
        "branchNameFilter" : ".*"
      },
      "executionMode" : "Consistent"
    },
    "sonarCheck" : {
      "alternativeProjectName" : "onec:rat-community",
      "enable" : true,
      "skipWithSupportLevel" : null,
      "waitForQualityGate" : false
    },
    "build" : {
      "engine" : "vrunner",
      "enable" : true
    },
    "publish" : {
      "enable" : true,
      "releasePrefixes" : [ "master"]
    },
    "notifications": {
      "maintainer": {
        "address": "Aleksey.Koryakin@bia-tech.ru",
        "transport": "email"
      },
      "team": []
    },
    "GLOBAL": {
      "platformVersion": "8.3.20.1996",
      "sources" : {
        "paths" : {
          "EXTENSION" : [ "exts"]
        }
      }
    }
  }
  
