#Область СлужебныйПрограммныйИнтерфейс

// Обрабатывает входящий API запрос. Метод предназначен для переопределения
// в дочерних модулях для реализации собственной логики обработки запросов.
//
// Параметры:
//   Запрос - HTTPЗапрос - входящий HTTP запрос
//   ОтказОсновнойФункции - Булево - флаг отказа от выполнения основной функции
//
// Возвращаемое значение:
//   Произвольный - результат обработки запроса или Неопределено, если обработка не выполнена
//
// Пример:
//  Результат = ЗапросAPI(Запрос, ОтказОсновнойФункции);
//  // Результат: результат обработки запроса или Неопределено
Функция ЗапросAPI(Запрос, ОтказОсновнойФункции) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

// Формирует ответ на API запрос. Метод предназначен для переопределения
// в дочерних модулях для реализации собственной логики формирования ответов.
//
// Параметры:
//   СтатусОбработкиЗапроса - см. РатОбщий.НовыйСтатусОбработкиЗапроса
//   ПараметрыЗапроса - Структура - параметры запроса
//   ОтказОсновнойФункции - Булево - флаг отказа от выполнения основной функции
//
// Возвращаемое значение:
//   Произвольный - сформированный ответ или Неопределено, если ответ не сформирован
//
// Пример:
//  Ответ = Ответ(СтатусОбработкиЗапроса, ПараметрыЗапроса, ОтказОсновнойФункции);
//  // Результат: сформированный ответ или Неопределено
Функция Ответ(СтатусОбработкиЗапроса, ПараметрыЗапроса, ОтказОсновнойФункции) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

// Вызывает обработчик запроса. Метод предназначен для переопределения
// в дочерних модулях для реализации собственной логики вызова обработчиков.
//
// Параметры:
//   Обработчик - Строка - имя обработчика
//   ПараметрыЗапроса - Структура - параметры запроса
//   СтатусОбработкиЗапроса - см. РатОбщий.НовыйСтатусОбработкиЗапроса
//   ОтказОсновнойПроцедуры - Булево - флаг отказа от выполнения основной процедуры
//
// Пример:
//  ВызватьОбработчик("ОбработчикЗапроса", ПараметрыЗапроса, СтатусОбработкиЗапроса, ОтказОсновнойПроцедуры);
Процедура ВызватьОбработчик(Обработчик, ПараметрыЗапроса, СтатусОбработкиЗапроса, ОтказОсновнойПроцедуры) Экспорт
	
	ОтказОсновнойПроцедуры = Ложь;

КонецПроцедуры

// Извлекает параметры из входящего запроса. Метод предназначен для переопределения
// в дочерних модулях для реализации собственной логики извлечения параметров.
//
// Параметры:
//   ШаблонЗапроса - Структура - шаблон запроса
//   Запрос - HTTPЗапрос - входящий HTTP запрос
//   СтатусОбработкиЗапроса - см. РатОбщий.НовыйСтатусОбработкиЗапроса
//   ОтказОсновнойФункции - Булево - флаг отказа от выполнения основной функции
//
// Возвращаемое значение:
//   Структура - извлеченные параметры запроса или Неопределено, если параметры не извлечены
//
// Пример:
//  Параметры = ПараметрыВходящегоЗапроса(ШаблонЗапроса, Запрос, СтатусОбработкиЗапроса, ОтказОсновнойФункции);
//  // Результат: структура с параметрами запроса или Неопределено
Функция ПараметрыВходящегоЗапроса(ШаблонЗапроса, Запрос, СтатусОбработкиЗапроса, ОтказОсновнойФункции) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти
