		.Свойство("ЭтаБаза").ЭтоИстина();
	
КонецПроцедуры

Процедура УстановитьНастройкиПодключения() Экспорт
	
	Контекст = Новый Структура();
	
	ОжидаемоеЗначение = РатШагиВанессыКлиентСервер.ОписаниеНастройкиПодключения();
	ОжидаемоеЗначение.Сервер = "jsonplaceholder.typicode.com";
	ОжидаемоеЗначение.Порт = 0;
	ОжидаемоеЗначение.Схема = "https";
	ОжидаемоеЗначение.Ресурс = "/";
	ОжидаемоеЗначение.Таймаут = 30;
	ОжидаемоеЗначение.Пользователь = "root";
	ОжидаемоеЗначение.Пароль = "2";
	
	Настройки = Новый Структура;
	Настройки.Вставить("Сервер", "jsonplaceholder.typicode.com");
	Настройки.Вставить("Схема", "https");
	Настройки.Вставить("Пользователь", "root");
	Настройки.Вставить("Пароль", "2");
	
	РатВызовСервисаКлиент.УстановитьНастройкиПодключения(Контекст, "jsonplaceholder", Настройки);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "jsonplaceholder"))
		.Заполнено()
		.Равно(ОжидаемоеЗначение);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Сервер", "https://root:2@jsonplaceholder.typicode.com");
	
	РатВызовСервисаКлиент.УстановитьНастройкиПодключения(Контекст, "jsonplaceholder", Настройки);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "jsonplaceholder"))
		.Заполнено()
		.Равно(ОжидаемоеЗначение);
	
	Настройки = Новый Структура;
	Настройки.Вставить("Сервер", "https://root:3@jsonplaceholder.typicode.com");
	Настройки.Вставить("Пароль", "2");
	
	РатВызовСервисаКлиент.УстановитьНастройкиПодключения(Контекст, "jsonplaceholder", Настройки);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "jsonplaceholder"))
		.Заполнено()
		.Равно(ОжидаемоеЗначение);
	
КонецПроцедуры

Процедура УстановитьЗаголовкиНастройкиПодключения() Экспорт
	
	ИмяНастройки = "jsonplaceholder";
	Контекст = НовыйКонтекстНастройкиПодключения(ИмяНастройки);
	Заголовки = ПомощникТестированияРат.ТаблицаГеркин("| Content-Type | application/json|");
	РатВызовСервисаКлиент.УстановитьЗаголовкиНастройкиПодключения(Контекст, ИмяНастройки, Заголовки);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, ИмяНастройки))
		.Свойство("Заголовки")
			.ИмеетТип("Соответствие")
			.ИмеетДлину(1)
			.ИмеетСвойство("Content-Type");
	
КонецПроцедуры

Процедура УстановитьРазрешенныеКодыОтветов() Экспорт
	
	ИмяНастройки = "jsonplaceholder";
	Контекст = НовыйКонтекстНастройкиПодключения(ИмяНастройки);
	Значение = ПомощникТестированияРат.ТаблицаГеркин(
		"| 500 |
		|| 404 |
		|| 403 |");
	РатВызовСервисаКлиент.УстановитьРазрешенныеКодыОтветов(Контекст, ИмяНастройки, Значение);
	
	ЮТест.ОжидаетЧто(РатВызовСервисаКлиент.НастройкиПодключения(Контекст, ИмяНастройки))
		.Свойство("РазрешенныеКодыСостояния")
			.ИмеетТип("Массив")
			.ИмеетДлину(3)
			.Содержит(500)
			.Содержит(404)
			.Содержит(403);
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_GET(ВыполнятьНаСервере) Экспорт
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com/posts");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "2");
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Структура")
			.ИмеетСвойство("userId")
			.ИмеетСвойство("body")
	;
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "comments");
	ОписаниеЗапроса.ПараметрыЗапроса = Новый Структура("postId", 2);
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Массив")
			.КаждыйЭлементСодержитСвойствоСоЗначением("postId", 2)
	;
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_POST(ВыполнятьНаСервере) Экспорт
	
	НастройкиПодключения = НоваяНастройкаПодключения("https://jsonplaceholder.typicode.com");
	НастройкиПодключения.ВыполнятьНаСервере = ВыполнятьНаСервере;
	
	Тело = Новый Структура;
	Тело.Вставить("title", ЮТест.Данные().СлучайнаяСтрока());
	Тело.Вставить("body", ЮТест.Данные().СлучайнаяСтрока());
	Тело.Вставить("userId", 1);
	
	ОписаниеЗапроса = ОписаниеЗапроса(НастройкиПодключения, , "posts");
	ОписаниеЗапроса.Метод = "POST";
	ОписаниеЗапроса.Тело = Тело;
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ)
		.Заполнено()
		.Свойство("КодСостояния").Равно(201)
		.Свойство("Тело").Заполнено()
			.ИмеетТип("Структура")
			.ИмеетСвойстваРавные(Тело)
			.ИмеетСвойство("id")
	;
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_ЭтаБаза_ПолучениеДанных() Экспорт
	
	ОписаниеЗапроса = ОписаниеЗапросаЭтаБаза("Справочник/ПУБ_ОбъектыМетаданных");
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Пустой справочник")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело")
			.ИмеетТип("Массив")
			.НеЗаполнено();
	
	Ссылка = ЮТест.Данные().КонструкторОбъекта("Справочник.ПУБ_ОбъектыМетаданных")
		.ФикцияОбязательныхПолей()
		.Установить("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Справочник"))
		.Установить("ПометкаУдаления", Истина)
		.Записать();
	
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Справочник с одной записью")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело").Заполнено()
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("ПометкаУдаления", Ложь));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по пометке удаления (Ложь)")
		.Свойство("Тело").НеЗаполнено()
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("ПометкаУдаления", Истина));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по пометке удаления (Истина)")
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Справочник")));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по тип (Справочник)")
		.Элемент("Тело[0]").Равно(Ссылка)
	;
	
	ОписаниеЗапроса.Тело = Новый Структура("filter", Новый Структура("Тип", ПредопределенноеЗначение("Перечисление.ПУБ_ТипыОбъектов.Документ")));
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	ЮТест.ОжидаетЧто(Ответ, "Отбор по тип (Документ)")
		.Свойство("Тело").НеЗаполнено()
	;
	
КонецПроцедуры

Процедура ВыполнитьHttpЗапрос_ЭтаБаза_Сериализация() Экспорт
	
	Ссылка = ЮТест.Данные().СоздатьЭлемент("Справочник.ПУБ_ОбъектыМетаданных");
	
	ОписаниеЗапроса = ОписаниеЗапросаЭтаБаза("Справочник/ПУБ_ОбъектыМетаданных", , Истина);
	Ответ = РатВызовСервисаКлиент.ВыполнитьHttpЗапрос(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Пустой справочник")
		.Заполнено()
		.Свойство("КодСостояния").Равно(200)
		.Свойство("Тело")
			.ИмеетТип("Массив")
			.Заполнено()
		.Свойство("Тело[0].id").Заполнено()
		.Свойство("Тело[0].presentation").Равно(Строка(Ссылка));
	
КонецПроцедуры

Процедура ИзменитьДанныеНаСервере() Экспорт
	
	ОписаниеЗапроса = ОписаниеЗапросаЭтаБаза("Справочник/ПУБ_ОбъектыМетаданных", "POST");
	ОписаниеЗапроса.Тело = РатВызовСервисаКлиент.ДанныеОбъектаИБ(Новый Структура());
	Ответ = РатВызовСервисаКлиент.ИзменитьДанныеНаСервере(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Создание элемента справочника")
		.Заполнено()
		.Свойство("Тело")
			.ИмеетТип("СправочникСсылка.ПУБ_ОбъектыМетаданных")
			.Заполнено();
	
КонецПроцедуры

Процедура ИзменитьДанныеНаСервере_Блокировка() Экспорт
	
	ОписаниеЗапроса = ОписаниеЗапросаЭтаБаза("Справочник/ПУБ_ОбъектыМетаданных", "POST");
	ОписаниеЗапроса.Тело = РатВызовСервисаКлиент.ДанныеОбъектаИБ(Новый Структура());
	
	Блокировка = ОписаниеБлокировки("Справочник.ПУБ_ОбъектыМетаданных");
	
	ЮТест.Данные().УстановитьФоновуюБлокировку(Блокировка);
	Ответ = РатВызовСервисаКлиент.ИзменитьДанныеНаСервере(ОписаниеЗапроса);
	
	ЮТест.ОжидаетЧто(Ответ, "Создание элемента справочника")
		.Заполнено()
		.Свойство("Тело")
			.ИмеетТип("СправочникСсылка.ПУБ_ОбъектыМетаданных")
			.Заполнено();
	
КонецПроцедуры

Процедура УдалитьЗаписиСоответствующиеОтбору_НетУдаляемыхДанных() Экспорт
	
	ИмяТаблицы = "Справочник.ПУБ_ОбъектыМетаданных";
	КонтекстВанессы = КонтекстВанессы();
	МетаданныеТаблицы = ПомощникТестированияРат.ТестовыеМетаданныеТаблицы(ИмяТаблицы);
	
	ЮТест.ОжидаетЧтоТаблицаБазы(ИмяТаблицы, "Таблица должна быть пустой")
		.НеСодержитЗаписи();
	
	Отбор = РатШагиВанессыКлиент.СтруктураПоиска(Новый Структура);
	РатВызовСервисаКлиент.УдалитьЗаписиСоответствующиеОтбору(КонтекстВанессы, МетаданныеТаблицы, "ЭтаБаза", Отбор);
	
КонецПроцедуры

Процедура УдалитьЗаписиСоответствующиеОтбору_ПериодическаяКонстанта() Экспорт
	
	ИмяТаблицы = "РегистрСведений.ПУБ_ПериодическаяКонстанта";
	КонтекстВанессы = КонтекстВанессы();
	МетаданныеТаблицы = ПомощникТестированияРат.ТестовыеМетаданныеТаблицы(ИмяТаблицы);
	
	Период = НачалоДня(ТекущаяДата());
	
	ЮТест.Данные().КонструкторОбъекта(ИмяТаблицы)
		.Установить("Период", Период)
		.Фикция("Значение")
		.Записать();
	
	Отбор = РатШагиВанессыКлиент.СтруктураПоиска(Новый Структура);
	РатВызовСервисаКлиент.УдалитьЗаписиСоответствующиеОтбору(КонтекстВанессы, МетаданныеТаблицы, "ЭтаБаза", Отбор);
	
КонецПроцедуры

Процедура ИдентификаторЗаписи_Справочник() Экспорт
	
	// Тест для справочника с полем Ссылка
	Запись = Новый Структура("Ссылка", Новый Структура("id", "test-id-123"));
	МетаданныеТаблицы = ПомощникТестированияРат.ТестовыеМетаданныеТаблицы("Справочник.ПУБ_ОбъектыМетаданных");
	
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Справочник с полем Ссылка")
		.Равно("test-id-123");
	
	// Тест для справочника с полем id
	Запись = Новый Структура("id", "direct-id-456");
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Справочник с полем id")
		.Равно("direct-id-456");
	
КонецПроцедуры

Процедура ИдентификаторЗаписи_РегистрСведений() Экспорт
	
	// Тест для регистра сведений с одним ключевым реквизитом
	МетаданныеТаблицы = ПомощникТестированияРат.ТестовыеМетаданныеТаблицы("РегистрСведений.ПУБ_ПериодическаяКонстанта");
	
	// Простое значение
	Запись = "test-value";
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Регистр с простым значением")
		.Содержит("Период=test-value");
	
	// Структура с одним полем
	Запись = Новый Структура("Период", "2024-01-01");
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Регистр со структурой")
		.Содержит("Период=2024-01-01");
	
КонецПроцедуры

Процедура ИдентификаторЗаписи_РегистрСведений_ТипизированноеЗначение() Экспорт
	
	// Тест для регистра сведений с типизированным значением
	МетаданныеТаблицы = ПомощникТестированияРат.ТестовыеМетаданныеТаблицы("РегистрСведений.ПУБ_ПериодическаяКонстанта");
	
	// Создаем тестовую ссылку
	Ссылка = ЮТест.Данные().СоздатьЭлемент("Справочник.ПУБ_ОбъектыМетаданных");
	
	// Типизированное значение
	ТипизированноеЗначение = Новый Структура("type, id");
	ТипизированноеЗначение.type = "СправочникСсылка.ПУБ_ОбъектыМетаданных";
	ТипизированноеЗначение.id = Ссылка;
	
	Запись = Новый Структура("Период", ТипизированноеЗначение);
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Регистр с типизированным значением")
		.Содержит("Период=СправочникСсылка.ПУБ_ОбъектыМетаданных.")
		.Содержит(Строка(Ссылка));
	
	// Обычное значение (не типизированное)
	Запись = Новый Структура("Период", Ссылка);
	Результат = РатВызовСервисаКлиент.ИдентификаторЗаписи(Запись, МетаданныеТаблицы);
	
	ЮТест.ОжидаетЧто(Результат, "Регистр с обычным значением")
		.Содержит("Период=" + Строка(Ссылка));
	
КонецПроцедуры

