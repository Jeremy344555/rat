Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		.УдалениеТестовыхДанных()
		
		.ДобавитьТест("НастройкиПодключений")
		.ДобавитьТест("НастройкиПодключения")
		.ДобавитьТест("НастройкиПодключения_ЭтаБаза")
		.ДобавитьТест("УстановитьНастройкиПодключения")
		.ДобавитьТест("УстановитьЗаголовкиНастройкиПодключения")
		.ДобавитьТест("УстановитьРазрешенныеКодыОтветов")
		.ДобавитьТест("ВыполнитьHttpЗапрос_GET")
			.СПараметрами(Ложь)
			.СПараметрами(Истина)
		.ДобавитьТест("ВыполнитьHttpЗапрос_POST")
			.СПараметрами(Ложь)
			.СПараметрами(Истина)
		.ДобавитьТест("ВыполнитьHttpЗапрос_ЭтаБаза_ПолучениеДанных")
		.ДобавитьТест("ВыполнитьHttpЗапрос_ЭтаБаза_Сериализация")
		.ДобавитьТест("УдалитьЗаписиСоответствующиеОтбору_НетУдаляемыхДанных")
		.ДобавитьТест("УдалитьЗаписиСоответствующиеОтбору_ПериодическаяКонстанта")
		.ДобавитьТест("ИдентификаторЗаписи_Справочник")
		.ДобавитьТест("ИдентификаторЗаписи_РегистрСведений")
		.ДобавитьТест("ИдентификаторЗаписи_РегистрСведений_ТипизированноеЗначение")
//		.ДобавитьТест("ИзменитьДанныеНаСервере")
//		.ДобавитьТест("ИзменитьДанныеНаСервере_Блокировка")
	;
	
КонецПроцедуры

Процедура НастройкиПодключений() Экспорт
	
	Контекст = Новый Структура();
	
	Шаблоны = РатВызовСервисаКлиент.НастройкиПодключений(Контекст);
	
	ЮТест.ОжидаетЧто(Шаблоны)
		.ИмеетТип("Соответствие");
	
	ЮТест.ОжидаетЧто(Контекст)
		.Свойство("РатНастройкиПодключений").Равно(Шаблоны);
	
КонецПроцедуры

Процедура НастройкиПодключения() Экспорт
	
	Контекст = Новый Структура();
	
КонецПроцедуры

Процедура НастройкиПодключения_ЭтаБаза() Экспорт
	
	Контекст = Новый Структура;
	НастройкиПодключения = РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "ЭтаБаза");
	
	ЮТест.ОжидаетЧто(НастройкиПодключения)
