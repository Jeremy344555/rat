#Область СлужебныеПроцедурыИФункции

Функция НовыйКонтекстНастройкиПодключения(ИмяНастройки)
	
	Контекст = Новый Структура();
	Настройки = Новый Структура;
	Настройки.Вставить("Сервер", "https://root:2@jsonplaceholder.typicode.com");
	РатВызовСервисаКлиент.УстановитьНастройкиПодключения(Контекст, ИмяНастройки, Настройки);
	
	Возврат Контекст;
	
КонецФункции

Функция НоваяНастройкаПодключения(Адрес)
	
	ПараметрыАдреса = РатКоннекторHTTP.РазобратьURL(Адрес);
	
	НастройкиПодключения = РатШагиВанессыКлиентСервер.ОписаниеНастройкиПодключения();
	
	НастройкиПодключения.Сервер = ПараметрыАдреса.Сервер;
	НастройкиПодключения.Порт = ПараметрыАдреса.Порт;
	НастройкиПодключения.Схема = ПараметрыАдреса.Схема;
	НастройкиПодключения.Ресурс = ПараметрыАдреса.Путь;
	НастройкиПодключения.Пользователь = ПараметрыАдреса.Аутентификация.Пользователь;
	НастройкиПодключения.Пароль = ПараметрыАдреса.Аутентификация.Пароль;
	НастройкиПодключения.Таймаут = 30;
	НастройкиПодключения.Заголовки = Новый Соответствие();
	НастройкиПодключения.РазрешенныеКодыСостояния = РатКоллекции.ЗначениеВМассиве(200, 201);
	
	Возврат НастройкиПодключения;
	
КонецФункции

Функция ОписаниеЗапроса(НастройкиПодключения, Метод = "GET", АдресРесурса = Неопределено)
	
	ОписаниеЗапроса = Новый Структура();
	ОписаниеЗапроса.Вставить("НастройкиПодключения", НастройкиПодключения);
	ОписаниеЗапроса.Вставить("Метод", Метод);
	ОписаниеЗапроса.Вставить("АдресРесурса", АдресРесурса);
	ОписаниеЗапроса.Вставить("Заголовки", Новый Соответствие());
	ОписаниеЗапроса.Вставить("ПараметрыЗапроса", Новый Структура);
	ОписаниеЗапроса.Вставить("Тело");
	ОписаниеЗапроса.Вставить("ПроверятьОтвет", Истина);
	ОписаниеЗапроса.Вставить("Отладка", Истина);
	
	Возврат ОписаниеЗапроса;
	
КонецФункции

Функция ОписаниеЗапросаЭтаБаза(АдресРесурса, Метод = "GET", ИспользуетсяСериализация = Ложь)
	
	Контекст = Новый Структура;
	НастройкиПодключения = РатВызовСервисаКлиент.НастройкиПодключения(Контекст, "ЭтаБаза");
	НастройкиПодключения.ИспользуетсяСериализация = ИспользуетсяСериализация;
	
	Возврат ОписаниеЗапроса(НастройкиПодключения, Метод, "Справочник/ПУБ_ОбъектыМетаданных");
	
КонецФункции

Функция ОписаниеБлокировки(Область, Режим = "Исключительный")
	
	Описание = Новый Структура;
	Описание.Вставить("Область", Область);
	Описание.Вставить("Режим", Режим);
	Описание.Вставить("Поля", Новый Массив);
	
	Возврат ЮТКоллекции.ЗначениеВМассиве(Описание);
	
КонецФункции

Функция КонтекстВанессы()
	
	КонтекстШагов = Новый Структура;
	КонтекстШагов.Вставить("Ванесса", Новый Структура("Объект", Новый Структура("DebugLog", Истина)));
	КонтекстШагов.Вставить("Контекст", Новый Структура);
	КонтекстШагов.Вставить("КонтекстСохраняемый", Новый Структура);
	
	Возврат КонтекстШагов;
	
КонецФункции

#КонецОбласти
