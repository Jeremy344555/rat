		.ФикцияОбязательныхПолей()
		.Записать();
	
	УИД = Строка(Справочник.УникальныйИдентификатор());
	ПараметрыДесериализации = Новый Структура("ОжидаемыйТип, Значение, ТипЗначения", ТипЗнч(Справочник.Ссылка), УИД, Тип("Строка"));
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
