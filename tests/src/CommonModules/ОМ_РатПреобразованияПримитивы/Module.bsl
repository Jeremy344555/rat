#Область ЗначениеВСтроку

// Тестирует преобразование значения в строку.
//
// Параметры:
//   ВходноеЗначение - Произвольный - значение для преобразования
//   ОжидаемаяСтрока - Строка - ожидаемый результат преобразования
//
Процедура ЗначениеВСтроку(ВходноеЗначение, ОжидаемаяСтрока) Экспорт
	// Arrange
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияПримитивы.ЗначениеВСтроку(ВходноеЗначение, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат преобразования").Равно(ОжидаемаяСтрока);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус выполнения").ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#Область СериализоватьПримитив

// Тестирует сериализацию примитивного значения.
//
// Параметры:
//   ВходноеЗначение - Произвольный - значение для сериализации
//   ТипЗначения - Тип - ожидаемый тип значения
//   ОжидаемыйРезультат - Произвольный - ожидаемый результат сериализации
//
Процедура СериализоватьПримитив(ВходноеЗначение, ТипЗначения, ОжидаемыйРезультат) Экспорт
	// Act
	Результат = РатПреобразованияПримитивы.СериализоватьПримитив(ВходноеЗначение, ТипЗначения);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации").Равно(ОжидаемыйРезультат);
	
	// Проверяем тип результата
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Дата") ИЛИ ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		ЮТест.ОжидаетЧто(Результат, "Тип результата").ИмеетТип("Строка");
	Иначе
		ЮТест.ОжидаетЧто(Результат, "Тип результата").ИмеетТип(ТипЗначения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ДесериализоватьПримитив

// Тестирует десериализацию примитивного значения.
//
// Параметры:
//   ВходноеЗначение - Строка - строка для десериализации
//   ОжидаемыйТип - Тип - ожидаемый тип результата
//   ОжидаемыйРезультат - Произвольный - ожидаемый результат десериализации
//
Процедура ДесериализоватьПримитив(ВходноеЗначение, ОжидаемыйТип, ОжидаемыйРезультат) Экспорт
	// Arrange
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияПримитивы.ДесериализоватьПримитив(ВходноеЗначение, ОжидаемыйТип, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат десериализации").Равно(ОжидаемыйРезультат);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус выполнения").ЭтоИстина();
КонецПроцедуры

#КонецОбласти

#КонецОбласти
