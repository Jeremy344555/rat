#Область СлужебныйПрограммныйИнтерфейс

// Регистрация тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		// СтрокаВДату
		.ДобавитьТест("СтрокаВДату")
			.СПараметрами("2024-01-15T14:30:00", Дата("20240115143000"), Истина).Представление("ISO8601 полная дата")
			.СПараметрами("14:30", Дата("00010101143000"), Истина).Представление("Короткое время HH:MM")
			.СПараметрами("14:30:45", Дата("00010101143045"), Истина).Представление("Короткое время HH:MM:SS")
			.СПараметрами("не дата", Дата("00010101000000"), Ложь).Представление("Некорректный формат")
			.СПараметрами("", Дата("00010101000000"), Ложь).Представление("Пустая строка")
		
		// ЗначениеВБулево
		.ДобавитьТест("ЗначениеВБулево")
			.СПараметрами("true", Истина, Истина)
				.Представление("Строка true")
			.СПараметрами("false", Ложь, Истина).Представление("Строка false")
			.СПараметрами(1, Истина, Истина).Представление("Число 1")
			.СПараметрами(0, Ложь, Истина).Представление("Число 0")
			.СПараметрами(Истина, Истина, Истина).Представление("Булево Истина")
			.СПараметрами(Ложь, Ложь, Истина).Представление("Булево Ложь")
			.СПараметрами("некорректное", Неопределено, Ложь).Представление("Некорректное значение")
		
		// ЗначениеВЧисло
		.ДобавитьТест("ЗначениеВЧисло")
			.СПараметрами("42", 42, Истина).Представление("Целое число")
			.СПараметрами("3.14", 3.14, Истина).Представление("Дробное число с точкой")
			.СПараметрами("3,14", 3.14, Истина).Представление("Дробное число с запятой")
			.СПараметрами("-42", -42, Истина).Представление("Отрицательное число")
			.СПараметрами("не число", Неопределено, Ложь).Представление("Некорректное значение")
			.СПараметрами("", 0, Истина).Представление("Пустая строка")
		
		// ЗначениеВСтроку
		.ДобавитьТест("ЗначениеВСтроку")
			.СПараметрами(42, "42").Представление("Число")
			.СПараметрами(Дата("20240115143000"), "15.01.2024 14:30:00").Представление("Дата")
			.СПараметрами(Истина, "Да").Представление("Булево")
			.СПараметрами(Новый УникальныйИдентификатор("a1b2c3d4-e5f6-7890-abcd-ef1234567890"), "a1b2c3d4-e5f6-7890-abcd-ef1234567890")
				.Представление("УникальныйИдентификатор")
		
		// СериализоватьПримитив
		.ДобавитьТест("СериализоватьПримитив")
			.СПараметрами("тестовая строка", Тип("Строка"), "тестовая строка").Представление("Строка")
			.СПараметрами(42, Тип("Число"), 42).Представление("Число")
			.СПараметрами(Истина, Тип("Булево"), Истина).Представление("Булево")
			.СПараметрами(Дата("20240115143000"), Тип("Дата"), "2024-01-15T14:30:00").Представление("Дата")
			.СПараметрами(Новый УникальныйИдентификатор("a1b2c3d4-e5f6-7890-abcd-ef1234567890"), Тип("УникальныйИдентификатор"), "a1b2c3d4-e5f6-7890-abcd-ef1234567890")
				.Представление("УникальныйИдентификатор")
		
		// ДесериализоватьПримитив
		.ДобавитьТест("ДесериализоватьПримитив")
			.СПараметрами("тестовая строка", Тип("Строка"), "тестовая строка").Представление("В строку")
			.СПараметрами("42", Тип("Число"), 42).Представление("В число")
			.СПараметрами("true", Тип("Булево"), Истина).Представление("В булево")
			.СПараметрами("2024-01-15T14:30:00", Тип("Дата"), Дата("20240115143000")).Представление("В дату")
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс

#Область СтрокаВДату

// Тестирует преобразование строки в дату с различными форматами.
//
// Параметры:
//   ВходнаяСтрока - Строка - строка для преобразования
//   ОжидаемаяДата - Дата - ожидаемый результат преобразования
//   ОжидаетсяУспех - Булево - ожидается ли успешное выполнение
//
Процедура СтрокаВДату(ВходнаяСтрока, ОжидаемаяДата, ОжидаетсяУспех) Экспорт
	// Arrange
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияПримитивы.ЗначениеВДату(ВходнаяСтрока, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат преобразования").Равно(ОжидаемаяДата);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус выполнения").Равно(ОжидаетсяУспех);
	
	Если НЕ ОжидаетсяУспех Тогда
		ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.ОписаниеОшибки, "Наличие ошибок").ИмеетДлинуБольше(0);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ЗначениеВБулево

// Тестирует преобразование значения в булево.
//
// Параметры:
