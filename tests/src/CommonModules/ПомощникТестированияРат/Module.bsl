#Область СлужебныйПрограммныйИнтерфейс

Процедура ПроверитьОтвет(Ответ, Описание, КодСостояния = 200) Экспорт
	
	ЮТест.ОжидаетЧто(Ответ, Описание)
		.ИмеетТип(Тип("HTTPСервисОтвет"))
		.Свойство("КодСостояния").Равно(КодСостояния, "верный код состояния. Тело: " + Ответ.ПолучитьТелоКакСтроку());
	
КонецПроцедуры

Процедура ПроверитьРезультатУспешно(Результат, Описание = Неопределено) Экспорт
	
	Если ЗначениеЗаполнено(Описание) Тогда
		ОписаниеКейса = СтрШаблон("%1. Возникли ошибки: %2", Описание, ТестированиеСервер.Представление(Результат));
	Иначе
		ОписаниеКейса = СтрШаблон("Возникли ошибки: %1", ТестированиеСервер.Представление(Результат));
	КонецЕсли;
	
	ЮТест.ОжидаетЧто(Результат, ОписаниеКейса)
		.Свойство("ОписаниеОшибки").НеЗаполнено()
		.Свойство("Успешно").ЭтоИстина();
	
КонецПроцедуры

Процедура ПроверитьРезультатОшибка(Результат, Описание = "", КлассОшибки = Неопределено) Экспорт
	
	ЮТест.ОжидаетЧто(Результат, Описание)
		.Свойство("Успешно").ЭтоЛожь("провальный обработчик")
		.Свойство("ОписаниеОшибки").Заполнено("не зарегистрированы ошибки");
	Если ЗначениеЗаполнено(КлассОшибки) Тогда
		ЮТест.ОжидаетЧто(Результат.ОписаниеОшибки[0].Класс, Описание)
			.Равно(КлассОшибки, "не верный класс ошибки");
	КонецЕсли;
	
КонецПроцедуры

Функция ДатаISO8601(Дата) Экспорт
	
	Возврат Формат(Дата, "ДФ=yyyy-MM-ddTHH:mm:ss;");
	
КонецФункции

Функция НовыйЗапрос(Адрес, Метод) Экспорт
	
	Запрос = СтруктураЗапроса();
	Запрос.ОтносительныйURL = Адрес;
	Запрос.HTTPМетод = Метод;
	
	Возврат Запрос;
	
КонецФункции

Функция СтруктураЗапроса(ContentType = "application/json") Экспорт
	
	Запрос = ЮТест.Данные().HTTPСервисЗапрос();
	
	Если ЗначениеЗаполнено(ContentType) Тогда
		Запрос.Заголовки.Вставить("Content-Type", ContentType);
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Функция ТаблицаГеркин(Строка) Экспорт
	
	КоличествоКолонок = СтрЧислоВхождений(СтрПолучитьСтроку(Строка, 1), "|") - 1;
	Заголовок = "";
	Разделитель = "|" + Символы.ПС;
	Для Инд = 1 По КоличествоКолонок Цикл
		Заголовок = Заголовок + "| Кол" + Инд;
		Разделитель = Разделитель + "| --- ";
	КонецЦикла;
	
	Таблица = Заголовок + Разделитель + "|" + Символы.ПС + Строка;
	
	Возврат ЮТест.Данные().ТаблицаMarkDown(Таблица);
	
КонецФункции

#Область ТестовыеДанные

Функция Статус() Экспорт
	
	Возврат РатОбщий.НовыйСтатусОбработкиЗапроса();
	
КонецФункции

Функция ПараметрыЗапроса(Адрес, Тело, СтатусОбработкиЗапроса) Экспорт
	
	ЧастиИмениТаблицы = СтрРазделить(Адрес, "/");
	ПараметрыЗапроса = Новый Структура("ТипМетаданных, ВидМетаданных, ИмяТаблицы, Идентификатор, Тело");
	ПараметрыЗапроса.ТипМетаданных = ЧастиИмениТаблицы[0];
	ПараметрыЗапроса.Тело = Тело;
	Если ЧастиИмениТаблицы.Количество() > 1 Тогда
		ПараметрыЗапроса.ВидМетаданных = ЧастиИмениТаблицы[1];
	КонецЕсли;
	
	Если ЧастиИмениТаблицы.Количество() > 2 Тогда
		ПараметрыЗапроса.Идентификатор = ЧастиИмениТаблицы[2];
	КонецЕсли;
	
	МетаданныеЗапроса = РатСервис.МетаданныеЗапроса(ПараметрыЗапроса, СтатусОбработкиЗапроса);
	ПроверитьРезультатУспешно(СтатусОбработкиЗапроса, "Получение описания метаданных из запроса");
	РатКоллекции.ОбъединитьВСтруктуру(ПараметрыЗапроса, МетаданныеЗапроса);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

Функция ПараметрыОбработчикаЗапроса(Обработчик, Адрес, Тело = Неопределено, Статус) Экспорт
	
	Для Каждого Шаблон Из РатШаблоныАдресов.Шаблоны() Цикл
		
		Если СтрСравнить(Шаблон.Обработчик, Обработчик) = 0 Тогда
			ШаблонОбработчика = Шаблон;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ШаблонОбработчика = Неопределено Тогда
		ВызватьИсключение "Не удалось найти шаблон обработчика " + Обработчик;
	КонецЕсли;
	
	ПараметрыЗапроса = Новый Структура("Параметры, Тело");
	ПараметрыЗапроса.Параметры = Новый Соответствие();
	ПараметрыЗапроса.Тело = Тело;
	
	РатКоллекции.ОбъединитьВСтруктуру(ПараметрыЗапроса, РатШаблоныАдресов.ПараметрыURL(ШаблонОбработчика, Адрес));
	
	МетаданныеЗапроса = РатСервис.МетаданныеЗапроса(ПараметрыЗапроса, Статус);
	ПроверитьРезультатУспешно(Статус, "Получение описания метаданных из запроса");
	РатКоллекции.ОбъединитьВСтруктуру(ПараметрыЗапроса, МетаданныеЗапроса);
	
	Возврат ПараметрыЗапроса;
	
КонецФункции

Функция ВызватьОбработчик(Модуль, Обработчик, Адрес, Тело = Неопределено) Экспорт
	
	ОбработчикВыполнен = Ложь;
	
	Статус = Статус();
	Параметры = ПараметрыОбработчикаЗапроса(Обработчик, Адрес, Тело, Статус);
	
	Статус.Результат = Модуль.ВызватьОбработчик(Обработчик, Параметры, Статус, ОбработчикВыполнен);
	
	ЮТест.ОжидаетЧто(ОбработчикВыполнен)
		.ЭтоИстина("Обработчик не выполнен");
	
	Возврат Статус;
	
КонецФункции

#КонецОбласти

Функция ЗапросAPI(Адрес, Метод, Тело) Экспорт
	
	Запрос = ЮТест.Данные().HTTPСервисЗапрос()
		.ОтносительныйURL(Адрес)
		.Метод(Метод)
		.УстановитьТелоКакСтрокуJSON(Тело);
	
	Ответ = РатСервис.ЗапросAPI(Запрос);
	
	Результат = Новый Структура();
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Тело", Ответ.ПолучитьТелоКакСтроку());
	Результат.Вставить("Данные", РатJSON.ОбъектИзСтроки(Результат.Тело));
	
	Возврат Результат;
	
КонецФункции

Функция ОбъектИзСтроки(Строка) Экспорт
	
	Возврат РатJSON.ОбъектИзСтроки(Строка);
	
КонецФункции

