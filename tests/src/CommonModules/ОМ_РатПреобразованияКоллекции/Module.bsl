#Область СериализоватьТаблицу

Процедура СериализоватьТаблицу_ПростаяТаблица() Экспорт
	
	// Arrange
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Колонка1");
	Таблица.Колонки.Добавить("Колонка2");
	
	Строка1 = Таблица.Добавить();
	Строка1.Колонка1 = "Значение1";
	Строка1.Колонка2 = 42;
	
	Строка2 = Таблица.Добавить();
	Строка2.Колонка1 = "Значение2";
	Строка2.Колонка2 = 100;
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьТаблицу(Таблица);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации таблицы")
		.ИмеетТип("Массив")
		.ИмеетДлину(2)
		.Свойство("[0]").ИмеетТип("Структура")
		.Свойство("[0].Колонка1").Равно("Значение1")
		.Свойство("[0].Колонка2").Равно(42);
	
КонецПроцедуры

