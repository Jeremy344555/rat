#Область СериализоватьМассив

Процедура СериализоватьМассив_ПростойМассив() Экспорт
	
	// Arrange
	Массив = Новый Массив;
	Массив.Добавить("Элемент1");
	Массив.Добавить(42);
	Массив.Добавить(Истина);
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьМассив(Массив);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации массива")
		.ИмеетТип("Массив")
		.ИмеетДлину(3)
		.Свойство("[0]").Равно("Элемент1")
		.Свойство("[1]").Равно(42)
		.Свойство("[2]").Равно(Истина);
	
КонецПроцедуры

Процедура СериализоватьМассив_ПустойМассив() Экспорт
	
	// Arrange
	Массив = Новый Массив;
	
