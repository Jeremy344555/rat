		.ИмеетДлину(0);
	
КонецПроцедуры

Процедура СериализоватьТаблицу_ТаблицаСРазнымиТипами() Экспорт
	
	// Arrange
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Строка");
	Таблица.Колонки.Добавить("Число");
	Таблица.Колонки.Добавить("Булево");
	Таблица.Колонки.Добавить("Дата");
	
	Строка = Таблица.Добавить();
	Строка.Строка = "Тест";
	Строка.Число = 42;
	Строка.Булево = Истина;
	Строка.Дата = ТекущаяДатаСеанса();
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьТаблицу(Таблица);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации таблицы с разными типами")
		.ИмеетТип("Массив")
		.ИмеетДлину(1)
		.Свойство("[0].Строка").Равно("Тест")
		.Свойство("[0].Число").Равно(42)
		.Свойство("[0].Булево").Равно(Истина);
	
