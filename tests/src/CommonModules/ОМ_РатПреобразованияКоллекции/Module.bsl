Процедура ПреобразоватьМассивДанных_ПростойМассив() Экспорт
	
	// Arrange
	Данные = Новый Массив;
	Данные.Добавить(Новый Структура("Поле1", "Значение1"));
	Данные.Добавить(Новый Структура("Поле1", "Значение2"));
	
	ОписаниеКоллекции = Новый Структура("Имя, ТипЭлемента, РеквизитыЭлемента", "ТестКоллекция", Тип("Структура"), Новый Массив);
	
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияКоллекции.ПреобразоватьМассивДанных(Данные, ОписаниеКоллекции, СтатусОбработкиЗапроса, "тест");
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат преобразования массива данных")
		.ИмеетТип("Массив")
		.ИмеетДлину(2);
	
