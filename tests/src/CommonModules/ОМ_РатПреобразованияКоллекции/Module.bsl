#Область СериализоватьСтруктуру

Процедура СериализоватьСтруктуру_ПростаяСтруктура() Экспорт
	
	// Arrange
	Структура = Новый Структура("Поле1, Поле2, Поле3", "Значение1", 42, Истина);
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьСтруктуру(Структура, ТипЗнч(Структура));
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации структуры")
		.ИмеетТип("Структура")
		.ИмеетДлину(3)
		.Свойство("Поле1").Равно("Значение1")
		.Свойство("Поле2").Равно(42)
		.Свойство("Поле3").Равно(Истина);
	
КонецПроцедуры

