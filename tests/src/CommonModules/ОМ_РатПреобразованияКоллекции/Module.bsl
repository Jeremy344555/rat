	ЮТест.ОжидаетЧто(Результат, "Результат сериализации пустого массива")
		.ИмеетТип("Массив")
		.ИмеетДлину(0);
	
КонецПроцедуры

Процедура СериализоватьМассив_ВложенныйМассив() Экспорт
	
	// Arrange
	Массив = Новый Массив;
	ВложенныйМассив = Новый Массив;
	ВложенныйМассив.Добавить("Вложенный1");
	ВложенныйМассив.Добавить("Вложенный2");
	Массив.Добавить(ВложенныйМассив);
	Массив.Добавить("Обычный");
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьМассив(Массив);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации вложенного массива")
		.ИмеетТип("Массив")
		.ИмеетДлину(2)
		.Свойство("[0]").ИмеетТип("Массив")
		.Свойство("[1]").Равно("Обычный");
	
КонецПроцедуры

