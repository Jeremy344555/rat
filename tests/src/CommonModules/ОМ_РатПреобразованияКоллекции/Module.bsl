		.ИмеетДлину(0);
	
КонецПроцедуры

Процедура СериализоватьСтруктуру_Соответствие() Экспорт
	
	// Arrange
	Соответствие = Новый Соответствие;
	Соответствие.Вставить("Ключ1", "Значение1");
	Соответствие.Вставить("Ключ2", 42);
	
	// Act
	Результат = РатПреобразованияКоллекции.СериализоватьСтруктуру(Соответствие, ТипЗнч(Соответствие));
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат сериализации соответствия")
		.ИмеетТип("Соответствие")
		.ИмеетДлину(2);
	
	// Проверяем содержимое соответствия
	ЮТест.ОжидаетЧто(Результат.Получить("Ключ1"), "Значение по ключу Ключ1").Равно("Значение1");
	ЮТест.ОжидаетЧто(Результат.Получить("Ключ2"), "Значение по ключу Ключ2").Равно(42);
	
КонецПроцедуры

