#Область СлужебныйПрограммныйИнтерфейс

// Регистрация тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		.ДобавитьТест("ИмяСистемногоПеречисления")
			.СПараметрами(Тип("ВидДвиженияНакопления"), "ВидДвиженияНакопления")
			.СПараметрами(Тип("ВидДвиженияБухгалтерии"), "ВидДвиженияБухгалтерии")
			.СПараметрами(Тип("РежимЗаписиДокумента"), "РежимЗаписиДокумента")
			.СПараметрами(Тип("РежимПроведенияДокумента"), "РежимПроведенияДокумента")
		.ДобавитьТест("МенеджерСистемногоПеречисления")
			.СПараметрами("AccumulationRecordType", "Receipt", ВидДвиженияНакопления.Приход)
			.СПараметрами("AccountingRecordType", "Debit", ВидДвиженияБухгалтерии.Дебет)
			.СПараметрами("DocumentWriteMode", "Write", РежимЗаписиДокумента.Запись)
			.СПараметрами("DocumentPostingMode", "RealTime", РежимПроведенияДокумента.Оперативный)
			.СПараметрами("ВидДвиженияНакопления", "Приход", ВидДвиженияНакопления.Приход)
			.СПараметрами("РежимЗаписиДокумента", "Запись", РежимЗаписиДокумента.Запись)
		.ДобавитьТест("КлючСистемногоПеречисления")
			.СПараметрами(ВидДвиженияНакопления.Приход, "Приход")
			.СПараметрами(ВидДвиженияНакопления.Расход, "Расход")
			.СПараметрами(ВидДвиженияБухгалтерии.Дебет, "Дебет")
			.СПараметрами(ВидДвиженияБухгалтерии.Кредит, "Кредит")
			.СПараметрами(РежимЗаписиДокумента.Запись, "Запись")
			.СПараметрами(РежимПроведенияДокумента.Оперативный, "Оперативный")
			.СПараметрами(РежимПроведенияДокумента.Неоперативный, "Неоперативный")
		.ДобавитьТест("ЗначениеСистемногоПеречисления")
			.СПараметрами(Тип("ВидДвиженияНакопления"), "Receipt", ВидДвиженияНакопления.Приход, Истина)
			.СПараметрами(Тип("ВидДвиженияНакопления"), "Expense", ВидДвиженияНакопления.Расход, Истина)
			.СПараметрами(Тип("ВидДвиженияБухгалтерии"), "Debit", ВидДвиженияБухгалтерии.Дебет, Истина)
			.СПараметрами(Тип("ВидДвиженияБухгалтерии"), "Credit", ВидДвиженияБухгалтерии.Кредит, Истина)
			.СПараметрами(Тип("РежимЗаписиДокумента"), "Write", РежимЗаписиДокумента.Запись, Истина)
			.СПараметрами(Тип("РежимПроведенияДокумента"), "RealTime", РежимПроведенияДокумента.Оперативный, Истина)
			.СПараметрами(Тип("ВидДвиженияНакопления"), "НесуществующееЗначение", Неопределено, Ложь)
		.ДобавитьТест("ИнтеграцияСФасадом_ИмяСистемногоПеречисления")
		.ДобавитьТест("ИнтеграцияСФасадом_КлючСистемногоПеречисления")
		.ДобавитьТест("ИнтеграцияСФасадом_ЗначениеСистемногоПеречисления");
	
КонецПроцедуры

#КонецОбласти

#Область Тесты_ИмяСистемногоПеречисления

// Параметризированный тест получения имени системного перечисления
//
// Параметры:
//   ТипПеречисления - Тип - тип системного перечисления
//   ОжидаемоеИмя - Строка - ожидаемое имя перечисления
//
Процедура ИмяСистемногоПеречисления(ТипПеречисления, ОжидаемоеИмя) Экспорт
	
	// Act
	Результат = РатПреобразованияСистемныеПеречисления.ИмяСистемногоПеречисления(ТипПеречисления);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Имя системного перечисления").Равно(ОжидаемоеИмя);
	
КонецПроцедуры

#КонецОбласти

#Область Тесты_МенеджерСистемногоПеречисления

// Параметризированный тест получения менеджера системного перечисления
//
// Параметры:
//   ИмяПеречисления - Строка - имя системного перечисления
//   ИмяСвойства - Строка - имя свойства менеджера для проверки
//   ОжидаемоеЗначение - Произвольный - ожидаемое значение свойства
//
Процедура МенеджерСистемногоПеречисления(ИмяПеречисления, ИмяСвойства, ОжидаемоеЗначение) Экспорт
	
	// Act
	Менеджер = РатПреобразованияСистемныеПеречисления.МенеджерСистемногоПеречисления(ИмяПеречисления);
	
	// Assert
	ЮТест.ОжидаетЧто(Менеджер, "Менеджер перечисления " + ИмяПеречисления)
		.Свойство(ИмяСвойства).Равно(ОжидаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область Тесты_КлючСистемногоПеречисления

// Параметризированный тест получения ключа системного перечисления
//
// Параметры:
//   ЗначениеПеречисления - Произвольный - значение системного перечисления
//   ОжидаемыйКлюч - Строка - ожидаемый ключ перечисления
//
Процедура КлючСистемногоПеречисления(ЗначениеПеречисления, ОжидаемыйКлюч) Экспорт
	
	// Act
	Ключ = РатПреобразованияСистемныеПеречисления.КлючСистемногоПеречисления(ЗначениеПеречисления);
	
	// Assert
	ЮТест.ОжидаетЧто(Ключ, "Ключ системного перечисления").Равно(ОжидаемыйКлюч);
	
КонецПроцедуры

#КонецОбласти

#Область Тесты_ЗначениеСистемногоПеречисления

// Параметризированный тест получения значения системного перечисления по ключу
//
// Параметры:
//   ОжидаемыйТип - Тип - ожидаемый тип системного перечисления
//   Ключ - Строка - ключ для поиска значения
//   ОжидаемоеЗначение - Произвольный - ожидаемое значение перечисления
//   ОжидаетсяУспех - Булево - ожидается ли успешное выполнение операции
//
Процедура ЗначениеСистемногоПеречисления(ОжидаемыйТип, Ключ, ОжидаемоеЗначение, ОжидаетсяУспех) Экспорт
	
	// Arrange
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразованияСистемныеПеречисления.ЗначениеСистемногоПеречисления(ОжидаемыйТип, Ключ, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Результат преобразования").Равно(ОжидаемоеЗначение);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки запроса").Равно(ОжидаетсяУспех);
	
	Если НЕ ОжидаетсяУспех Тогда
		ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.ОписаниеОшибки.Количество(), "Количество ошибок").Больше(0);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область Тесты_ИнтеграцияСФасадом

// Тест интеграции с фасадом - получение имени системного перечисления
Процедура ИнтеграцияСФасадом_ИмяСистемногоПеречисления() Экспорт
	
	// Arrange
	Тип = Тип("ВидДвиженияНакопления");
	
	// Act
	Результат = РатПреобразования.ИмяСистемногоПеречисления(Тип);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Имя системного перечисления через фасад").Равно("ВидДвиженияНакопления");
	
КонецПроцедуры

// Тест интеграции с фасадом - получение ключа системного перечисления
Процедура ИнтеграцияСФасадом_КлючСистемногоПеречисления() Экспорт
	
	// Arrange
	Значение = ВидДвиженияНакопления.Приход;
	
	// Act
	Ключ = РатПреобразования.КлючСистемногоПеречисления(Значение);
	
	// Assert
	ЮТест.ОжидаетЧто(Ключ, "Ключ системного перечисления через фасад").Равно("Приход");
	
КонецПроцедуры

// Тест интеграции с фасадом - получение значения системного перечисления
Процедура ИнтеграцияСФасадом_ЗначениеСистемногоПеречисления() Экспорт
	
	// Arrange
	ОжидаемыйТип = Тип("ВидДвиженияНакопления");
	Ключ = "Receipt";
	СтатусОбработкиЗапроса = РатОбщий.НовыйСтатусОбработкиЗапроса();
	
	// Act
	Результат = РатПреобразования.ЗначениеСистемногоПеречисления(ОжидаемыйТип, Ключ, СтатусОбработкиЗапроса);
	
	// Assert
	ЮТест.ОжидаетЧто(Результат, "Значение системного перечисления через фасад").Равно(ВидДвиженияНакопления.Приход);
	ЮТест.ОжидаетЧто(СтатусОбработкиЗапроса.Успешно, "Статус обработки через фасад").ЭтоИстина();
	
КонецПроцедуры

#КонецОбласти
