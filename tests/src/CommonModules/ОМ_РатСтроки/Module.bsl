Процедура СтрокуВМассив(Значение, Разделитель, УдалятьКонцевыеПробелы, Фиксированный, ОжидаемоеКоличество) Экспорт
	
	// Выполнение
	Результат = РатСтроки.СтрокуВМассив(Значение, Разделитель, УдалятьКонцевыеПробелы, Фиксированный);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Разбиение строки '%1' по разделителю '%2'", Значение, Разделитель))
		.ИмеетТип("Массив");
	
	ЮТест.ОжидаетЧто(Результат.Количество(), "Количество элементов в массиве")
		.Равно(ОжидаемоеКоличество);
	
	// Проверка типа возвращаемого массива
	Если Фиксированный Тогда
		ЮТест.ОжидаетЧто(Результат, "Фиксированный массив")
			.ИмеетТип("ФиксированныйМассив");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Дополнительные тесты для проверки сложных сценариев

Процедура ДополнительныеТестыПутей() Экспорт
	
	// Тест объединения 3 частей пути
	Результат = РатСтроки.ОбъединитьПути("/", "api", "v1", "users");
	ЮТест.ОжидаетЧто(Результат, "Объединение трех частей пути")
		.Равно("api/v1/users");
	
	// Тест объединения 5 частей пути
	РазделительПути = "\";
	ОжидаемыйПуть = "C:" + РазделительПути + "Program Files" + РазделительПути + "1C" + РазделительПути + "bin" + РазделительПути + "1cv8.exe";
	Результат = РатСтроки.ОбъединитьПути(РазделительПути, "C:", "Program Files", "1C", "bin", "1cv8.exe");
	ЮТест.ОжидаетЧто(Результат, "Объединение пяти частей пути")
		.Равно(ОжидаемыйПуть);
	
КонецПроцедуры

Процедура ДополнительныеТестыСтрокТолькоЦифры() Экспорт
	
	СтрокаОшибочныхСимволов = "";
	СтрокаТестирования = "123abc456";
	
	// Тест с получением ошибочных символов
	Результат = РатСтроки.СтрокаСодержитТолькоЦифры(СтрокаТестирования, СтрокаОшибочныхСимволов, Истина, Истина);
	
	ЮТест.ОжидаетЧто(Результат, "Результат проверки строки с буквами")
		.Равно(Ложь);
	
	ЮТест.ОжидаетЧто(СтрокаОшибочныхСимволов, "Найденные недопустимые символы")
		.Равно("abc");
	
	ЮТест.ОжидаетЧто(СтрокаТестирования, "Очищенная строка")
		.Равно("123456");
	
КонецПроцедуры

Процедура ДополнительныеТестыИнформацииОбОшибке() Экспорт
	
	// Создание тестовой информации об ошибке
	Попытка
		ВызватьИсключение "Тестовая ошибка";
	Исключение
		ИнформацияОшибки = ИнформацияОбОшибке();
	КонецПопытки;
	
	// Тест преобразования ИнформацияОбОшибке в строку
	Результат = РатСтроки.ИнформациюОбОшибкеВСтроку(ИнформацияОшибки);
	
	ЮТест.ОжидаетЧто(Результат, "Преобразование ИнформацияОбОшибке в строку")
		.Заполнено()
		.НеРавно("");
	
	ЮТест.ОжидаетЧто(Результат, "Содержит описание ошибки")
		.Содержит("Тестовая ошибка");
	
КонецПроцедуры

Процедура ТестыГраничныхСлучаев() Экспорт
	
	// Тест пустых входных параметров
	Результат = РатСтроки.СтрокаСодержитПрефикс("", "", "", Истина);
	ЮТест.ОжидаетЧто(Результат, "Пустые строки для префикса")
		.Равно(Ложь);
	
	// Тест с нулевыми параметрами для формирования строки символов
	Результат = РатСтроки.СформироватьСтрокуСимволов("", 5);
	ЮТест.ОжидаетЧто(Результат, "Формирование из пустого символа")
		.Равно("");
	
	// Тест разбиения пустой строки
	Результат = РатСтроки.СтрокуВМассив("", ";", Ложь, Истина);
	ЮТест.ОжидаетЧто(Результат, "Разбиение пустой строки в фиксированный массив")
		.ИмеетТип("ФиксированныйМассив");
	
	ЮТест.ОжидаетЧто(Результат.Количество(), "Количество элементов при разбиении пустой строки")
		.Равно(0);
	
	// Тест с пробелами в проверке на цифры
	СтрокаТестирования = "123 456";
	Результат = РатСтроки.СтрокаСодержитТолькоЦифры(СтрокаТестирования, , , Ложь);
	ЮТест.ОжидаетЧто(Результат, "Проверка строки с пробелами без учета пробелов")
		.Равно(Истина);
	
КонецПроцедуры

Процедура ПреобразоватьВИдентификатор(ИсходнаяСтрока, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
	Результат = РатСтроки.ПреобразоватьВИдентификатор(ИсходнаяСтрока);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Преобразование '%1' в camel case", ИсходнаяСтрока))
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

