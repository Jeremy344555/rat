#Область СлужебныйПрограммныйИнтерфейс

// ИсполняемыеСценарии
// 	Сервисный метод для получения списка тестовых методов
Процедура ИсполняемыеСценарии() Экспорт
	
	ЮТТесты.ВТранзакции()
		.ДобавитьТест("ЭтоУникальныйИдентификатор")
			.СПараметрами("12345678-1234-1234-1234-123456789012", Истина) // Корректный GUID
			.СПараметрами("12345678-1234-1234-1234-12345678901", Ложь)    // Неправильная длина
			.СПараметрами("1234567g-1234-1234-1234-123456789012", Ложь)   // Недопустимый символ
			.СПараметрами("", Ложь)                                       // Пустая строка
			.СПараметрами("не-guid", Ложь)                                // Некорректный формат
		.ДобавитьТест("СформироватьСтрокуСимволов")
			.СПараметрами("*", 5, "*****")
			.СПараметрами("А", 3, "ААА")
			.СПараметрами("X", 0, "")
			.СПараметрами("12", 2, "1212")
		.ДобавитьТест("СтрокаСодержитПрефикс")
			.СПараметрами("префикс_текст", "префикс", "_", Истина, Истина)
			.СПараметрами("ПРЕФИКС_ТЕКСТ", "префикс", "_", Ложь, Истина)
			.СПараметрами("текст", "префикс", "_", Истина, Ложь)
			.СПараметрами("префикстекст", "префикс", "", Истина, Истина)
		.ДобавитьТест("СократитьПрефикс")
			.СПараметрами("префикс_текст", "префикс", "_", Истина, "текст")
			.СПараметрами("ПРЕФИКС_ТЕКСТ", "префикс", "_", Ложь, "ТЕКСТ")
			.СПараметрами("текст", "префикс", "_", Истина, "текст")
			.СПараметрами("префикстекст", "префикс", "", Истина, "текст")
		.ДобавитьТест("СтрокаСодержитТолькоЦифры")
			.СПараметрами("12345", Истина)
			.СПараметрами("123abc", Ложь)
			.СПараметрами("", Ложь)
			.СПараметрами("123 456", Ложь)
		.ДобавитьТест("УдалитьПовторяющиесяСимволы")
			.СПараметрами("///текст", "/", "Слева", "текст")
			.СПараметрами("текст///", "/", "Справа", "текст")
			.СПараметрами("текст", "/", "Слева", "текст")
		.ДобавитьТест("ДобавитьСтроку")
			.СПараметрами("первая", "вторая", ";", "первая;вторая")
			.СПараметрами("", "вторая", ";", "вторая")
			.СПараметрами("первая", "", ";", "первая")
			.СПараметрами("", "", ";", "")
		.ДобавитьТест("РусскиеБуквы")
			.СПараметрами(Ложь, "абвгдеёжзийклмнопрстуфхцчшщъыьэюя")
			.СПараметрами(Истина, "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ")
		.ДобавитьТест("АнглийскиеБуквы")
			.СПараметрами(Ложь, "abcdefghijklmnopqrstuvwxyz")
			.СПараметрами(Истина, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ")
		.ДобавитьТест("Цифры")
			.СПараметрами("0123456789")
		.ДобавитьТест("НаборСимволов")
			.СПараметрами(Истина, Ложь, Ложь, Ложь, Неопределено, "абвгдеёжзийклмнопрстуфхцчшщъыьэюя")
			.СПараметрами(Ложь, Истина, Ложь, Ложь, Неопределено, "abcdefghijklmnopqrstuvwxyz")
			.СПараметрами(Ложь, Ложь, Истина, Ложь, Неопределено, "0123456789")
			.СПараметрами(Истина, Истина, Истина, Истина, "_", "абвгдеёжзийклмнопрстуфхцчшщъыьэюяАБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯabcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_")
		.ДобавитьТест("ПредставлениеОшибки")
			.СПараметрами("Тестовая ошибка", Истина, "Тестовая ошибка")
			.СПараметрами(Неопределено, Истина, "Неизвестная ошибка.")
		.ДобавитьТест("ОбъединитьПутиURL")
			.СПараметрами("api", "v1", "api/v1")
			.СПараметрами("/api/", "/v1/", "/api/v1/")
			.СПараметрами("api", "v1/users", "api/v1/users")
		.ДобавитьТест("ОбъединитьПути")
			.СПараметрами("\", "C:", "data", "C:" + "\" + "data")
			.СПараметрами("/", "home", "user", "home/user")
		.ДобавитьТест("ЧислоВСтроку")
			.СПараметрами(123, "123")
			.СПараметрами(0, "0")
			.СПараметрами(-456, "-456")
		.ДобавитьТест("СтрокуВМассив")
			.СПараметрами("a;b;c", ";", Ложь, Ложь, 3)
			.СПараметрами("a, b, c", ",", Истина, Ложь, 3)
			.СПараметрами("", ";", Ложь, Ложь, 0)
			.СПараметрами("одно", ";", Ложь, Ложь, 1)
		.ДобавитьТест("ПреобразоватьВИдентификатор")
			.СПараметрами("Отмена проведения", "ОтменаПроведения")
			.СПараметрами("Состояние фонового задания", "СостояниеФоновогоЗадания")
			.СПараметрами("Активно", "Активно")
			.СПараметрами("", "")
			.СПараметрами("  Завершено аварийно  ", "ЗавершеноАварийно")
			.СПараметрами("Пассивный", "Пассивный")
			.СПараметрами("один", "Один")
			.СПараметрами("много    слов    в    строке", "МногоСловВСтроке")
		.ДобавитьТест("ДополнительныеТестыПутей")
		.ДобавитьТест("ДополнительныеТестыСтрокТолькоЦифры")
		.ДобавитьТест("ДополнительныеТестыИнформацииОбОшибке")
		.ДобавитьТест("ТестыГраничныхСлучаев")
	;
	
КонецПроцедуры

Процедура ЭтоУникальныйИдентификатор(ИдентификаторСтрока, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
	Результат = РатСтроки.ЭтоУникальныйИдентификатор(ИдентификаторСтрока);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Проверка GUID '%1'", ИдентификаторСтрока))
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура СформироватьСтрокуСимволов(Символ, КоличествоСимволов, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
	Результат = РатСтроки.СформироватьСтрокуСимволов(Символ, КоличествоСимволов);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Формирование строки из '%1' длиной %2", Символ, КоличествоСимволов))
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура СтрокаСодержитПрефикс(ИсходнаяСтрока, Префикс, Разделитель, СУчетомРегистра, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
	Результат = РатСтроки.СтрокаСодержитПрефикс(ИсходнаяСтрока, Префикс, Разделитель, СУчетомРегистра);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Проверка префикса '%1' в строке '%2'", Префикс, ИсходнаяСтрока))
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура СократитьПрефикс(ИсходнаяСтрока, Префикс, Разделитель, СУчетомРегистра, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
	Результат = РатСтроки.СократитьПрефикс(ИсходнаяСтрока, Префикс, Разделитель, СУчетомРегистра);
	
	// Проверки
	ЮТест.ОжидаетЧто(Результат, СтрШаблон("Сокращение префикса '%1' из строки '%2'", Префикс, ИсходнаяСтрока))
		.Равно(ОжидаемыйРезультат);
	
КонецПроцедуры

Процедура СтрокаСодержитТолькоЦифры(СтрокаПроверки, ОжидаемыйРезультат) Экспорт
	
	// Выполнение
